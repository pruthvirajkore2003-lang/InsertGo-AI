# InsertGo.AI Website — environment variables
# Copy this file to `.env.local` and fill real values there.
# `.env.local` is git-ignored; NEVER commit real secrets.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser — put ONLY non-secret values there.

# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://insertgo.ai

# ── Auth (Better Auth) ─────────────────────────────────
# Generate secret with:  openssl rand -base64 32   (or `npx @better-auth/cli secret`)
BETTER_AUTH_SECRET=
# Must match the URL the site is served from (http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000

# Supabase Postgres connection string (Project Settings → Database → Connection string → URI).
# Use the "Transaction" pooler string on serverless hosts. Do NOT append
# ?sslmode=require: node-postgres treats it as verify-full AND lets it override
# the ssl config, so verification fails without a CA. TLS is configured in code
# (lib/pgSsl.ts) via SUPABASE_CA_CERT below — any ssl* URL param is stripped.
DATABASE_URL=

# Supabase Root CA for verified database TLS. Download from Project Settings →
# Database → SSL Configuration → Download certificate ("Supabase Root 2021 CA",
# prod-ca-2021.crt) and paste it as a single-line, \n-escaped PEM. This is a
# public root cert, not a secret. Required in production; if unset in dev the
# app still connects over an encrypted-but-unverified link.
SUPABASE_CA_CERT=

# ── Supabase PostgREST (REQUIRED for /api/ai/generate) ─
# That route runs on the Edge runtime, which has no TCP sockets, so it cannot
# use DATABASE_URL above — it reaches the quota/credit RPCs over PostgREST
# instead (lib/db.ts). Auth and sign-in do NOT need these: the session lookup
# goes to Better Auth over HTTP. So with these unset the app looks completely
# healthy right up until the first generation, which fails closed.
# Project Settings → API → Project URL / service_role key.
# The service-role key is server-only — never expose it to a client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Also run supabase-edge-rpc.sql once in the SQL Editor: without the
# `consume_quota` / `debit_credit` functions PostgREST answers 404 and
# generation fails the same way.

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI:  {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / OTP (Resend) ───────────────────────────────
# resend.com → API Keys. Without a key, OTPs print to the dev server console.
RESEND_API_KEY=
# Verified sender. `onboarding@resend.dev` works for testing without domain setup.
EMAIL_FROM="InsertGo <onboarding@resend.dev>"

# ── Operator alerts (lib/alert.ts) ─────────────────────
# Where events that must not sit in a log go — today: a paid credit pack whose
# webhook matched no user (money taken, nothing granted). Unset falls back to
# console.error, which is where those lines already went unread. A PagerDuty /
# Opsgenie intake address works here.
OPS_ALERT_TO=

# ── Content-Security-Policy (middleware.ts) ────────────
# The CSP carries a per-request nonce for script-src. Set to 1 to emit it as
# Content-Security-Policy-Report-Only while staging a policy change — for
# testing a new directive, not for running without a policy.
CSP_REPORT_ONLY=

# ── Analytics (optional, browser-safe) ─────────────────
NEXT_PUBLIC_ANALYTICS_ID=

# ── Download links (optional) ──────────────────────────
NEXT_PUBLIC_DOWNLOAD_URL_WINDOWS=

# ── Payments (Dodo Payments, Merchant of Record) ───────
# Dashboard → Developer → API Keys. Powers POST /api/billing/checkout.
DODO_API_KEY=
# Dashboard → Developer → Webhooks → Signing Secret (whsec_...). Verifies
# POST /api/billing/webhook; subscribe the endpoint to subscription.* events.
DODO_WEBHOOK_SECRET=
# Product ids from Dashboard → Products. Checkout returns 503 "Billing isn't
# configured yet." until DODO_API_KEY and the relevant product id are set.
DODO_PRODUCT_ID_PLUS=
DODO_PRODUCT_ID_PRO=
# One-time credit pack product ids (must match the pack sizes in lib/dodo.ts).
DODO_PRODUCT_ID_PACK_50=
DODO_PRODUCT_ID_PACK_150=
DODO_PRODUCT_ID_PACK_350=
DODO_PRODUCT_ID_PACK_500=
# "test" (default) targets test.dodopayments.com; set "live" in production.
DODO_ENV=test

# ── AI proxy (server-side Gemini key) ──────────────────
# Server-held Google Gemini API key used by /api/ai/generate and project-local
# google-video MCP tools. The desktop app holds NO LLM key and proxies every
# generation here (SPEC §10). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Grounding-capable model for opt-in web-search grounding (pass 1). Leave blank
# to disable grounding unless the request model is itself grounding-capable
# (the client's default gemini-2.5-flash-lite is NOT). Recommended:
#   NOT gemini-2.5-flash/pro — both now 404 for keys issued after their
#   retirement ("no longer available to new users"), which surfaces as a 502
#   from the grounded path. ListModels still lists them; only a real call tells.
GEMINI_GROUNDING_MODEL=gemini-3.6-flash

# ── Semantic cache (/api/ai/generate) ──────────────────
# In-process ANN (HNSW) response cache: a prompt that is a near-duplicate of an
# already-answered one (same model + system prompt, cosine similarity at/above
# the threshold) is served instantly from cache instead of re-hitting Gemini.
# All values below are optional; the shown values are the code defaults.
# Set 0 to disable the cache entirely.
SEMCACHE_ENABLED=1
# Embedding model + output dimensionality for lookups. Lower dims = lower
# lookup latency; safe because vectors are re-normalized in code.
SEMCACHE_EMBED_MODEL=gemini-embedding-001
SEMCACHE_EMBED_DIM=768
# Quality floor: serve a hit only at/above this cosine similarity.
SEMCACHE_MIN_SIMILARITY=0.95
# Max time (ms) a cache miss may spend waiting on the lookup embedding before
# generation proceeds (the embedding continues and is reused to store the
# result — no second embed call).
SEMCACHE_LOOKUP_TIMEOUT_MS=250
# Entry lifetime and per-(model+system) capacity.
SEMCACHE_TTL_HOURS=24
SEMCACHE_MAX_ENTRIES=1000
# HNSW graph parameters (defaults fine; raise M / EF_SEARCH for larger caches).
SEMCACHE_HNSW_M=16
SEMCACHE_HNSW_EF_CONSTRUCTION=200
SEMCACHE_HNSW_EF_SEARCH=64

# Per-user quota on /api/ai/generate (fixed-window, enforced in Postgres). Caps
# how many generations one account may make per minute (burst) and per day —
# stops a single user from draining the shared Gemini key. Defaults if unset:
GEN_BURST_MAX=15
GEN_DAILY_MAX=200
# How many times ONE Idempotency-Key may be replayed after its charge. A replay
# serves a full generation and debits nothing (that is what makes a timed-out
# client's retry whole), so an unbounded one turns a single credit into the whole
# daily quota. The desktop makes at most 3 attempts on one key
# (GEMINI_MAX_ATTEMPTS), so 2 is the floor — lower it and real retries 409.
GEN_MAX_REPLAYS=2

# Enterprise SSO: comma-separated emails allowed to POST /api/auth/sso/register.
# Better Auth gates that endpoint on a session alone, so leaving this empty
# (the default) blocks provider registration for everyone — a signed-in
# stranger must never be able to claim an email domain's IdP.
SSO_ADMIN_EMAILS=
