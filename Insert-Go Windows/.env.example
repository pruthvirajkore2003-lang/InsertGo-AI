# ============================================================================
# InsertGo-AI — frontend (Vite) env file.
#
# Setup:  copy this file to `.env`  (that copy is git-ignored) and fill values.
#         cp .env.example .env
#
# Only VITE_-prefixed vars are read, and they are inlined into the browser
# bundle — so NEVER put a secret here. The app holds no LLM key: every
# generation is proxied to the website's /api/ai/generate, where the Gemini key
# is server-held.
# ============================================================================

# Auth/API base URL — the InsertGo AI website (Next.js) hosts the Better Auth
# server (Google / SSO / email-OTP + desktop device-authorization sign-in) and
# the /api/ai/generate proxy.
# Dev: http://localhost:3000 (website `npm run dev`). Prod: https://insertgo.com
# A production build (`vite build`) REFUSES to run while this is unset or points
# at localhost — the shipped bundle would otherwise send the session bearer token
# to whatever is listening on the user's port 3000. Set VITE_ALLOW_DEV_API_URL=1
# to bundle against a local server on purpose.
VITE_API_URL=http://localhost:3000

# Optional build-time override: the Gemini model the proxy is asked to use.
# Leave it commented out to build with the shared default from the monorepo
# root's shared-config.json (defaultGeminiModel), which vite.config.ts inlines.
# Set it only to build against a different model — it MUST also be in the
# website's GEMINI_ALLOWED_MODELS or every generation returns 400.
# VITE_GEMINI_MODEL=

# NOTE: this app holds NO secret of its own. Sessions are issued and signed by
# the website's Better Auth server (BETTER_AUTH_SECRET, website .env.local); the
# desktop only stores the resulting bearer token in Windows Credential Manager.
# The former `JWT_SECRET` here signed a local auth server that no longer exists
# — it was removed 2026-08-06 (see compliance/secret-rotation.md). Do not
# reintroduce a secret into this file: the Vite dev server can serve it.
